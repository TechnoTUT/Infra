apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ node_ip }}
nodeRegistration:
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ node_ip }}"
# kube-proxy は Cilium で置き換える。
skipPhases:
  - addon/kube-proxy
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
controlPlaneEndpoint: "{{ api_endpoint }}:{{ api_port }}"
networking:
  podSubnet: {{ pod_cidr }}
  serviceSubnet: {{ service_cidr }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
failSwapOn: {{ kubelet_fail_swap_on | lower }}
systemReserved:
  memory: {{ kubelet_system_reserved_memory }}
kubeReserved:
  memory: {{ kubelet_kube_reserved_memory }}
evictionHard:
  memory.available: {{ kubelet_eviction_memory }}
