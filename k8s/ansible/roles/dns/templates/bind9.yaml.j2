apiVersion: v1
kind: Secret
metadata:
  name: bind-tsig
  namespace: {{ dns_namespace }}
type: Opaque
stringData:
  externaldns.key: |
    key "{{ externaldns_tsig_keyname }}" {
        algorithm hmac-sha256;
        secret "{{ vault_externaldns_tsig_secret }}";
    };
---
apiVersion: v1
kind: Secret
metadata:
  name: external-dns-tsig
  namespace: {{ dns_namespace }}
type: Opaque
stringData:
  secret: "{{ vault_externaldns_tsig_secret }}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: bind-options
  namespace: {{ dns_namespace }}
data:
  named.conf: |-
    include "/etc/bind/keys/externaldns.key";
    include "/etc/bind/named.conf.options";
    include "/etc/bind/named.conf.default-zones";
  named.conf.options: |-
    options {
        directory "/var/cache/bind";
        allow-query { any; };
        forwarders { 1.1.1.1; 1.0.0.1; };
        recursion yes;
        dnssec-validation auto;
    };
  named.conf.default-zones: |-
    zone "{{ dns_zone }}" {
        type master;
        file "/etc/bind/pri/svc/svc.zone";
        allow-transfer { key "{{ externaldns_tsig_keyname }}"; };
        update-policy { grant {{ externaldns_tsig_keyname }} zonesub ANY; };
    };
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: bind-svc-zone
  namespace: {{ dns_namespace }}
data:
  svc.zone: |-
    $TTL 60
    @   IN  SOA ns.{{ dns_zone }}. admin.{{ dns_zone }}. (
            2025100401 ; Serial
            3600       ; Refresh
            1800       ; Retry
            1209600    ; Expire
            86400 )    ; Minimum TTL

        IN  NS  ns.{{ dns_zone }}.
    ns  IN  A   {{ bind9_lb_ip }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: bind-svc-zone-pvc
  namespace: {{ dns_namespace }}
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 1Gi
  storageClassName: {{ bind9_storage_class }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: bind9
  namespace: {{ dns_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: bind9
  template:
    metadata:
      labels:
        app: bind9
    spec:
      initContainers:
        - name: init-zone
          image: docker.io/busybox
          command: ["/bin/sh", "-c"]
          args:
            # bind（非 root）が更新用のジャーナルを作れるよう、書き込みを許可する。
            - chmod 0777 /data && if [ ! -f /data/svc.zone ]; then cp /config/svc.zone /data/svc.zone; fi
          volumeMounts:
            - { name: bind-svc-zone-config, mountPath: /config }
            - { name: bind-svc-zone-pvc, mountPath: /data }
      containers:
        - name: bind9
          image: {{ bind9_image }}
          ports:
            - { containerPort: 53, protocol: UDP }
            - { containerPort: 53, protocol: TCP }
          resources:
            requests: { cpu: 20m, memory: 64Mi }
            limits: { memory: 256Mi }
          volumeMounts:
            - { name: bind-options, mountPath: /etc/bind }
            - { name: bind-svc-zone-pvc, mountPath: /etc/bind/pri/svc }
            - { name: bind-tsig, mountPath: /etc/bind/keys, readOnly: true }
      volumes:
        - name: bind-options
          configMap: { name: bind-options }
        - name: bind-svc-zone-config
          configMap: { name: bind-svc-zone }
        - name: bind-svc-zone-pvc
          persistentVolumeClaim: { claimName: bind-svc-zone-pvc }
        - name: bind-tsig
          secret: { secretName: bind-tsig }
---
apiVersion: v1
kind: Service
metadata:
  name: bind9
  namespace: {{ dns_namespace }}
spec:
  type: LoadBalancer
  loadBalancerIP: {{ bind9_lb_ip }}
  selector:
    app: bind9
  ports:
    - { name: dns-tcp, protocol: TCP, port: 53, targetPort: 53 }
    - { name: dns-udp, protocol: UDP, port: 53, targetPort: 53 }
