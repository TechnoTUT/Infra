# FortiGate の dns-entry には TXT が置けないので、所有者の記録 (TXT registry) は使わない (registry: noop)。
# ゾーンは webhook 専用。Kubernetes 側にないレコードは消える (policy: sync)。
provider:
  name: webhook
  webhook:
    image:
      repository: {{ externaldns_webhook_image }}
      tag: "{{ externaldns_webhook_tag }}"
    env:
      - { name: FORTIGATE_URL, value: "{{ externaldns_fortigate_url }}" }
      - { name: FORTIGATE_ZONE, value: "{{ externaldns_fortigate_zone }}" }
      - { name: FORTIGATE_REVERSE_ZONES, value: "{{ externaldns_fortigate_reverse_zones | join(',') }}" }
      - { name: FORTIGATE_INSECURE_SKIP_VERIFY, value: "{{ externaldns_fortigate_insecure | lower }}" }
      - { name: FORTIGATE_TOKEN_IN_QUERY, value: "{{ externaldns_fortigate_token_in_query | lower }}" }
      - { name: DRY_RUN, value: "{{ externaldns_fortigate_dry_run | lower }}" }
      # API キーは Secret から渡す (Deployment に平文で残さない)。
      - name: FORTIGATE_TOKEN
        valueFrom:
          secretKeyRef:
            name: external-dns-fortigate
            key: token
    readinessProbe:
      httpGet:
        path: /readyz
        port: http-webhook
    securityContext:
      runAsNonRoot: true
      runAsUser: 65532    # distroless の nonroot
      runAsGroup: 65532
      readOnlyRootFilesystem: true
      allowPrivilegeEscalation: false
      capabilities: { drop: [ALL] }
    resources:
      requests: { cpu: 10m, memory: 16Mi }
      limits: { memory: 64Mi }
sources: [service, ingress, crd]
domainFilters:
  - {{ dns_zone }}
policy: sync
registry: noop
managedRecordTypes: [A, AAAA, CNAME]
interval: 1m
logLevel: info
rbac:
  create: true
resources:
  requests: { cpu: 20m, memory: 32Mi }
  limits: { memory: 128Mi }
