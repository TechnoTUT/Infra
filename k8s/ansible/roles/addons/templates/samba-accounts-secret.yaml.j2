apiVersion: v1
kind: Namespace
metadata:
  name: {{ nas_namespace }}
---
# Samba のアカウント（smbpasswd 形式。ghcr.io/technotut/samba が起動時に取り込む）
apiVersion: v1
kind: Secret
metadata:
  name: samba-accounts
  namespace: {{ nas_namespace }}
type: Opaque
stringData:
  smbpasswd: {{ vault_samba_smbpasswd | to_json }}
