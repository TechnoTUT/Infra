apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: {{ item.name }}
  namespace: {{ item.namespace }}
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "{{ item.network }}",
      "type": "bridge",
      "bridge": "{{ item.bridge }}",
      "ipam": {
        "type": "host-local",
        "subnet": "{{ item.subnet }}"
      }
    }
