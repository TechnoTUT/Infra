# bind9 専用（FortiGate の DNS 転送先）。
apiVersion: cilium.io/v2
kind: CiliumLoadBalancerIPPool
metadata:
  name: dns
spec:
  blocks:
    - cidr: {{ bind9_lb_ip }}/32
  serviceSelector:
    matchLabels:
      io.kubernetes.service.namespace: {{ dns_namespace }}
      io.kubernetes.service.name: bind9
---
# その他の LoadBalancer。bind9 専用の IP は含めない。
apiVersion: cilium.io/v2
kind: CiliumLoadBalancerIPPool
metadata:
  name: default
spec:
  blocks:
    - start: "{{ cilium_lb_pool_start }}"
      stop: "{{ cilium_lb_pool_stop }}"
