{% set ghcr_auth = {'auths': {'ghcr.io': {
     'username': vault_ghcr_username,
     'password': vault_ghcr_token,
     'auth': (vault_ghcr_username ~ ':' ~ vault_ghcr_token) | b64encode}}} %}
{% for ns in ghcr_pull_secret_namespaces %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ns }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ ghcr_pull_secret_name }}
  namespace: {{ ns }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: {{ ghcr_auth | to_json | b64encode }}
{% endfor %}
