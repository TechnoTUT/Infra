apiVersion: v1
kind: Namespace
metadata:
  name: arc-runners
---
apiVersion: v1
kind: Secret
metadata:
  name: arc-github-app
  namespace: arc-runners
type: Opaque
stringData:
  github_app_id: {{ vault_arc_github_app_id | string | to_json }}
  github_app_installation_id: {{ vault_arc_github_app_installation_id | string | to_json }}
  github_app_private_key: {{ vault_arc_github_app_private_key | to_json }}
