{#
  BGP の相手（cilium_bgp_peers）ごとに PeerConfig・ClusterConfig・Advertisement を作る。
  ClusterConfig はノードのラベル bgp.technotut.net/peer=<name> で対象のノードを選ぶ（addons の nodes.yml が付ける）。
#}
{% for p in cilium_bgp_peers %}
---
apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: bgp-peer-config-{{ p.name }}
spec:
  gracefulRestart:
    enabled: true
    restartTimeSeconds: 15
  timers:
    holdTimeSeconds: 90
    keepAliveTimeSeconds: 30
  families:
    - afi: ipv4
      safi: unicast
      advertisements:
        matchLabels:
          advertise: bgp-{{ p.name }}
---
apiVersion: cilium.io/v2
kind: CiliumBGPClusterConfig
metadata:
  name: bgp-cluster-config-{{ p.name }}
spec:
  nodeSelector:
    matchLabels:
      bgp.technotut.net/peer: {{ p.name }}
  bgpInstances:
    - name: instance-{{ cilium_bgp_local_asn }}
      localASN: {{ cilium_bgp_local_asn }}
      peers:
        - name: {{ p.name }}
          peerAddress: "{{ p.address }}"
          peerASN: {{ p.asn }}
          peerConfigRef:
            name: bgp-peer-config-{{ p.name }}
---
apiVersion: cilium.io/v2
kind: CiliumBGPAdvertisement
metadata:
  name: bgp-advertisement-{{ p.name }}
  labels:
    advertise: bgp-{{ p.name }}
spec:
  advertisements:
    - advertisementType: Service
      service:
        addresses:
          - LoadBalancerIP
{% if p.services | default('all') == 'all' %}
      # 全ての LoadBalancer の IP を広報する
      # （externalTrafficPolicy: Local の Service は、Pod のあるノードだけが広報する）
      selector:
        matchExpressions:
          - key: not-exist-label-name
            operator: NotIn
            values: [dummy-value]
{% else %}
      # bgp.technotut.net/peer={{ p.name }} のラベルがある Service だけを広報する
      selector:
        matchLabels:
          bgp.technotut.net/peer: {{ p.name }}
{% endif %}
    - advertisementType: PodCIDR
      attributes:
        communities:
          standard:
            - "{{ cilium_bgp_local_asn }}:99"
{% endfor %}
