# クラスタの名前と ID（Cluster Mesh で使う。変えたら全ての Pod を作り直す）
cluster:
  name: {{ cilium_cluster_name }}
  id: {{ cilium_cluster_id }}
ipv4:
  enabled: true
routingMode: native
ipam:
  mode: kubernetes
# Cluster Mesh のため、両方のクラスタの Pod CIDR を含む範囲にする。
ipv4NativeRoutingCIDR: {{ cilium_native_routing_cidr | default(pod_cidr) }}
autoDirectNodeRoutes: true
kubeProxyReplacement: true
k8sRequireIPv4PodCIDR: true
# DNS が使えない段階でも API に届くよう IP を指定する。
k8sServiceHost: {{ api_endpoint }}
k8sServicePort: {{ api_port }}
# Multus と共存させる。既定 (exclusive: true) では、Cilium が他の CNI の設定
# (Multus の 00-multus.conf) を *.cilium_bak に退避してしまい、VM や Pod に
# br10・br20 のインターフェースが付かない。
cni:
  exclusive: {{ (not multus_enabled) | lower }}
bgpControlPlane:
  enabled: true
# Pod から外部（TUT の DNS、GitHub など）へ出る通信は、ノードの IP に NAT する。
# Pod CIDR 宛て（ipv4NativeRoutingCIDR）の通信は NAT されない。
enableIPv4Masquerade: true
ingressController:
  enabled: {{ cilium_ingress_enabled | lower }}
  loadbalancerMode: shared
# メモリが少ないため常駐を減らす。Hubble は使わない。
hubble:
  enabled: false
# 設定（ConfigMap）を変えたとき、agent と operator を自動で再起動する。
rollOutCiliumPods: true
operator:
  rollOutPods: true
  replicas: 1
{% if cilium_clustermesh_enabled %}
# ===== Cluster Mesh =====
# 証明書は Helm が作る。両方のクラスタで同じ CA を使う（vault.yml）。
tls:
  ca:
    cert: {{ vault_cilium_ca_crt | b64encode }}
    key: {{ vault_cilium_ca_key | b64encode }}
clustermesh:
  useAPIServer: true
  apiserver:
    service:
      type: NodePort
      nodePort: {{ cilium_clustermesh_port }}
    resources:
      requests: { cpu: 50m, memory: 64Mi }
  config:
    enabled: true
    clusters:
{% for c in cilium_clustermesh_clusters %}
      {{ c.name }}:
        ips: {{ c.ips | to_json }}
        port: {{ cilium_clustermesh_port }}
{% endfor %}
{% endif %}
