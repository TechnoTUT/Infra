---
# 実際の vault.yml は次で作る（暗号化して Git に入れてよい）:
#   ansible-vault create inventory/group_vars/all/vault.yml
# 例: ExternalDNS (RFC2136) 用の TSIG キー
vault_externaldns_tsig_secret: "CHANGE_ME"
# 例: GitHub Actions の self-hosted runner (ARC) が使う GitHub App
#     TechnoTUT の org に App を作ってインストールし、次の 3 つを入れる
vault_arc_github_app_id: "CHANGE_ME"                 # App ID (または Client ID)
vault_arc_github_app_installation_id: "CHANGE_ME"    # インストール ID
vault_arc_github_app_private_key: |
  -----BEGIN RSA PRIVATE KEY-----
  CHANGE_ME
  -----END RSA PRIVATE KEY-----
# 例: NAS の Samba のアカウント (smbpasswd 形式。1 行に 1 アカウント)
#     旧 NAS で `sudo pdbedit -L -w` を実行した出力をそのまま入れる (パスワードは平文で持たない)
vault_samba_smbpasswd: |
  technotut:1000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX:CHANGE_ME_NT_HASH_32_HEX_CHARS___:[U          ]:LCT-00000000:
# 例: Cilium Cluster Mesh の共通の CA (main と nas の両方のクラスタで使う。PEM)
#     openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=Cilium CA" -keyout ca.key -out ca.crt
vault_cilium_ca_crt: |
  -----BEGIN CERTIFICATE-----
  CHANGE_ME
  -----END CERTIFICATE-----
vault_cilium_ca_key: |
  -----BEGIN PRIVATE KEY-----
  CHANGE_ME
  -----END PRIVATE KEY-----
